<Window x:Class="Project1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Football LiveScore"
        Height="520" Width="920"
        Loaded="Window_Loaded"
        Background="#F5F6FA">

    <Window.Resources>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MatchTemplate">
            <Border BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,12"
                    Background="White">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="{Binding Home.Logo}" Width="22" Height="22" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Home.Name}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Away.Logo}" Width="22" Height="22" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Away.Name}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="{Binding League}" Opacity="0.6" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding DisplayKickoff}" Opacity="0.6"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayScore}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayStatus}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2E5CB8" Offset="0"/>
                    <GradientStop Color="#1B3C8C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <TextBlock Text="FOOTBALL LIVE SCORE"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <TabControl x:Name="tabMain">

                <TabItem Header="Menu">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="FOOTBALL LIVE SCORE"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"
                                       Foreground="#2E5CB8"/>

                            <TextBlock Text="View live scores, fixtures and match details."
                                       FontSize="14"
                                       Opacity="0.75"/>

                            <Border Height="220"
                                    Margin="0,20,0,0"
                                    CornerRadius="10"
                                    BorderBrush="#DDD"
                                    BorderThickness="1"
                                    ClipToBounds="True">

                                <Grid>
                                    <Image Source="pack://application:,,,/Images/football.jpg"
                                           Stretch="UniformToFill"
                                           Opacity="0.85"/>

                                    <Border Background="#66000000"/>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Premier League"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="Live Scores • Fixtures • Results"
                                                   FontSize="14"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Live Matches" Style="{StaticResource NavButtonStyle}" Click="BtnGoLive_Click"/>
                            <Button Content="Fixtures / Results" Style="{StaticResource NavButtonStyle}" Click="BtnGoFixtures_Click"/>
                            <Button Content="Exit" Style="{StaticResource NavButtonStyle}" Click="BtnExit_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Live">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Live Matches"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#2E5CB8"
                                       Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="League:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="cmbLiveLeague" Width="180" SelectionChanged="CmbLiveLeague_SelectionChanged"/>
                                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                <TextBox x:Name="txtLiveSearch" Width="200" TextChanged="TxtLiveSearch_TextChanged"/>
                                <Button Content="Back" Margin="18,0,0,0" Click="BtnBackToMenu_Click"/>
                            </StackPanel>

                            <ListBox x:Name="lstLive"
                                     ItemTemplate="{StaticResource MatchTemplate}"
                                     SelectionChanged="LstMatches_SelectionChanged"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="White"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Match Details"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#2E5CB8"/>
                                <TextBlock x:Name="txtDetailsTitle"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtDetailsInfo"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Events"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,14,0,6"/>
                                <ListBox x:Name="lstEvents"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Fixtures">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fixtures / Results"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#2E5CB8"
                                       Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="rbFixtures" Content="Fixtures" IsChecked="True"
                                             Checked="RbMode_Checked" Margin="0,0,14,0"/>
                                <RadioButton x:Name="rbResults" Content="Results"
                                             Checked="RbMode_Checked" Margin="0,0,18,0"/>
                                <TextBlock Text="League:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="cmbFixLeague" Width="150" SelectionChanged="CmbFixLeague_SelectionChanged"/>
                                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                <TextBox x:Name="txtFixSearch" Width="150" TextChanged="TxtFixSearch_TextChanged"/>
                                <Button Content="Back" Margin="18,0,0,0" Click="BtnBackToMenu_Click"/>
                            </StackPanel>

                            <ListBox x:Name="lstFixtures"
                                     ItemTemplate="{StaticResource MatchTemplate}"
                                     SelectionChanged="LstMatches_SelectionChanged"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="White"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Match Details"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#2E5CB8"/>
                                <TextBlock x:Name="txtDetailsTitle2"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtDetailsInfo2"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Events"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,14,0,6"/>
                                <ListBox x:Name="lstEvents2"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="League Table">
                    <Grid>
                        <TextBlock Text="Premier League Table"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#2E5CB8"
                                   Margin="0,0,0,12"/>

                        <DataGrid x:Name="dgTable"
                                  Margin="0,40,0,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding rnk}" Width="50"/>
                                <DataGridTextColumn Header="Team" Binding="{Binding Tnm}" Width="*"/>
                                <DataGridTextColumn Header="Played" Binding="{Binding pld}" Width="80"/>
                                <DataGridTextColumn Header="Wins" Binding="{Binding win}" Width="70"/>
                                <DataGridTextColumn Header="Draws" Binding="{Binding drw}" Width="70"/>
                                <DataGridTextColumn Header="Losses" Binding="{Binding lst}" Width="80"/>
                                <DataGridTextColumn Header="Points" Binding="{Binding pts}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>